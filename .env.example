# Nur nötig, wenn der LLM-Judge (llm.enabled: true) genutzt wird.
# Alternativ: `ant auth login` – das SDK findet das Profil automatisch.
ANTHROPIC_API_KEY=

# Für private/gated Hugging-Face-Datensätze
HF_TOKEN=

# Reddit-API für `scamguard data sammeln --quellen reddit` (App vom Typ „script“ auf
# https://www.reddit.com/prefs/apps). Reddit verlangt einen beschreibenden User-Agent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:scamguard-forschung:0.11 (by /u/DEIN_NAME)
