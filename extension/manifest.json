{
  "manifest_version": 3,
  "name": "ScamGuard – Kleinanzeigen-Check",
  "short_name": "ScamGuard",
  "version": "0.8.0",
  "description": "Markiert Betrugsindikatoren in Kleinanzeigen und im Kleinanzeigen-Chat direkt auf der Seite und zeigt einen Risiko-Score. Analyse lokal über den ScamGuard-Server.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ScamGuard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.kleinanzeigen.de/*",
    "https://img.kleinanzeigen.de/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.kleinanzeigen.de/s-anzeige/*",
        "https://www.kleinanzeigen.de/m-nachrichten*"
      ],
      "js": [
        "lib/icons.js",
        "content/extract.js",
        "content/highlight.js",
        "content/panel.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "scamguard@dhbw-ki-projekt",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
